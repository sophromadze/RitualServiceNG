{
  "name": "ritual-service-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:deploy": "bash build-deploy.sh",
    "build:deploy:win": "build-deploy.bat",
    "build:ssr": "ng build --configuration production",
