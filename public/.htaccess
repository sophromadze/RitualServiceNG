RewriteEngine On

# Set default file
DirectoryIndex index.csr.html

# Redirect old /ka URLs to root (Georgian is now default)
RewriteRule ^ka/?$ / [R=301,L]
RewriteRule ^ka/(.*)$ /$1 [R=301,L]

# Serve existing files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule .* - [L]

# Serve existing directories directly
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule .* - [L]

# Handle Angular routes - serve index.csr.html for all other routes
RewriteRule .* /index.csr.html [L]